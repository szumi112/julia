{
  "name": "bearwithme-panel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode demo",
    "dev:app": "vite --mode app",
    "build": "npm run build:demo",
    "build:demo": "vite build --mode demo",
    "build:app": "vite build --mode app",
    "build:staging": "CLOUDFLARE_ENV=staging vite build --mode staging",
    "build:production": "CLOUDFLARE_ENV=production vite build --mode production",
    "preview": "vite preview --mode demo",
    "preview:app": "vite preview --mode app",
    "deploy": "npm run deploy:demo",
    "deploy:demo": "npm run build:demo && gh-pages -d dist/demo",
    "deploy:staging": "npm run check:repo && npm run build:staging && node scripts/assert-repository-safety.mjs --dist --env staging && wrangler deploy",
    "deploy:production": "npm run check:repo && npm run build:production && node scripts/assert-repository-safety.mjs --dist --env production && wrangler deploy",
    "test": "node --test tests/unit/**/*.test.js",
    "test:scripts": "node --test --test-concurrency=1 tests/scripts/*.test.js",
    "test:worker": "vitest run --config vitest.worker.config.js",
    "test:e2e": "playwright test",
    "test:e2e:app": "playwright test --config playwright.app.config.js",
    "check:repo": "node scripts/assert-repository-safety.mjs",
    "configure:cloudflare": "node scripts/configure-cloudflare-env.mjs",
    "seed:local": "node scripts/seed-local.mjs",
    "dev:app:e2e": "node scripts/run-app-e2e.mjs",
    "migrate:core:stage-a": "APP_ENV=development DATA_MODE=fictional node scripts/apply-core-migration-stage.js stage-a --local",
    "migrate:core:stage-a:staging": "DATA_MODE=fictional node scripts/apply-core-migration-stage.js stage-a --remote --env staging",
    "migrate:core:stage-a:production": "DATA_MODE=fictional node scripts/apply-core-migration-stage.js stage-a --remote --env production",
    "migrate:core:stage-b": "APP_ENV=development DATA_MODE=fictional node scripts/apply-core-migration-stage.js stage-b --local",
    "migrate:core:stage-b:staging": "DATA_MODE=fictional node scripts/apply-core-migration-stage.js stage-b --remote --env staging",
    "migrate:core:stage-b:production": "DATA_MODE=fictional node scripts/apply-core-migration-stage.js stage-b --remote --env production",
    "migrate:core:stage-c": "APP_ENV=development DATA_MODE=fictional node scripts/apply-core-migration-stage.js stage-c --local",
    "migrate:core:stage-c:staging": "DATA_MODE=fictional node scripts/apply-core-migration-stage.js stage-c --remote --env staging",
    "migrate:core:stage-c:production": "DATA_MODE=fictional node scripts/apply-core-migration-stage.js stage-c --remote --env production",
    "migrate:core:stage-d": "APP_ENV=development DATA_MODE=fictional node scripts/apply-core-migration-stage.js stage-d --local",
    "migrate:core:stage-d:staging": "DATA_MODE=fictional node scripts/apply-core-migration-stage.js stage-d --remote --env staging",
    "migrate:core:stage-d:production": "DATA_MODE=fictional node scripts/apply-core-migration-stage.js stage-d --remote --env production",
    "migrate:core:stage-e": "APP_ENV=development DATA_MODE=fictional node scripts/apply-core-migration-stage.js stage-e --local",
    "migrate:core:stage-e:staging": "DATA_MODE=fictional node scripts/apply-core-migration-stage.js stage-e --remote --env staging",
    "migrate:core:stage-e:production": "DATA_MODE=fictional node scripts/apply-core-migration-stage.js stage-e --remote --env production",
    "migration:status:staging": "APP_ENV=staging DATA_MODE=fictional node scripts/migration-status-staging.mjs",
    "upgrade:core-directory": "APP_ENV=development DATA_MODE=fictional node scripts/upgrade-core-directory.js",
    "upgrade:core-directory:staging": "DATA_MODE=fictional node scripts/upgrade-core-directory.js --remote --env staging",
    "upgrade:core-directory:production": "DATA_MODE=fictional node scripts/upgrade-core-directory.js --remote --env production",
    "backup:create:staging": "APP_ENV=staging DATA_MODE=fictional node scripts/backup-staging.mjs create",
    "backup:status:staging": "APP_ENV=staging DATA_MODE=fictional node scripts/backup-staging.mjs status",
    "backup:migrations:staging": "APP_ENV=staging DATA_MODE=fictional node scripts/backup-staging.mjs migrations",
    "backup:restore": "APP_ENV=staging DATA_MODE=fictional node scripts/restore-backup.mjs",
    "rollout:workbook:staging": "APP_ENV=staging DATA_MODE=fictional node scripts/workbook-rollout-staging.mjs",
    "smoke:staging": "APP_ENV=staging DATA_MODE=fictional node scripts/staging-smoke.mjs",
    "audit:workbook": "node scripts/audit-workbook.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/heebo": "5.3.0",
    "@fontsource/alata": "5.3.0",
    "fflate": "0.8.3",
    "gsap": "3.15.0",
    "hono": "4.12.32",
    "jose": "6.2.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.185.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1097.0",
    "@cloudflare/vite-plugin": "1.48.0",
    "@cloudflare/vitest-pool-workers": "0.19.0",
    "@playwright/test": "1.61.1",
    "@vitejs/plugin-react": "4.7.0",
    "gh-pages": "6.3.0",
    "vite": "6.4.3",
    "vitest": "4.1.10",
    "wrangler": "4.115.0"
  },
  "overrides": {
    "vite": {
      "postcss": "8.5.25"
    }
  }
}
